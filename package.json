{
  "name": "royal-medics",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:db": "pnpm --filter @rmc/core dev:db",
    "db:migrate": "pnpm --filter @rmc/db migrate",
    "db:seed": "pnpm --filter @rmc/core seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  }
}
